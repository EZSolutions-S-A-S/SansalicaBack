# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# API Key para clientes de solo lectura (header: Authorization: Api-Key <token>)
READ_API_KEY=change-me-to-a-random-api-key

# Cloudflare R2 (S3-compatible). Dejar USE_R2_STORAGE=False para usar almacenamiento local en disco.
USE_R2_STORAGE=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# CORS: orígenes permitidos para el panel admin (Astro), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Implementación concreta del repositorio de productos (Dependency Inversion). Opcional.
# MAQUILLAJE_REPOSITORY_CLASS=maquillaje.infrastructure.repository.MaquillajeRepositoryImpl

# Implementación concreta del repositorio de Inmuebles (Dependency Inversion). Opcional.
# INMUEBLE_REPOSITORY_CLASS=inmuebles.infrastructure.repository.DjangoInmuebleRepository
